---
import Layout from "../../layouts/base.astro";
import Panel from "../../components/terminal-panel.astro";
import { toolReference } from "../../data/tool-reference";
const base = import.meta.env.BASE_URL;
---
<Layout title="Tool reference">
  <h1 class="mb-2 text-2xl text-accent">~ tools / ranger</h1>
  <p class="mb-8 text-dim">Eleven v0.3 commands documented from the current Bash implementation. Exit statuses and limitations matter: a report is not a safety guarantee.</p>
  <div class="grid gap-5">{toolReference.map(tool => <Panel label={tool.slug + ".sh"}>
    <p>{tool.details}</p>
    <p class="mt-2 text-xs text-dim">{tool.impact}</p>
    <a class="mt-2 inline-block text-sm text-accent underline" href={`${base}tools/${tool.slug}/`}>Open manual →</a>
  </Panel>)}</div>
</Layout>
